{
  "name": "bigal",
  "version": "16.3.3",
  "description": "A type-safe PostgreSQL ORM for TypeScript on Node.js, Bun, and Deno. Fluent query builder, decorator-based models, and queries tuned for Postgres.",
  "keywords": [
    "bun",
    "database",
    "decorator",
    "deno",
    "fluent-api",
    "jsonb",
    "node",
    "orm",
    "pg",
    "pgvector",
    "postgres",
    "postgresql",
    "query-builder",
    "repository-pattern",
    "sql",
    "type-safe",
    "typescript"
  ],
  "homepage": "https://bigalorm.dev/",
  "bugs": {
    "url": "https://github.com/bigalorm/bigal/issues"
  },
  "license": "MIT",
  "author": "Jim Geurts <jim@biacreations.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigalorm/bigal.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "vp pack",
    "check:types": "tsc --noEmit --skipLibCheck",
    "test": "pnpm run check:types && vp test run",
    "lint:markdown": "markdownlint '**/*.md' --ignore '**/node_modules/**' --ignore '**/dist/**' --ignore 'internal/**' --config=.github/linters/.markdown-lint.yml --fix",
    "lint:code": "vp lint --fix",
    "lint": "pnpm run format && run-p lint:*",
    "format": "vp fmt",
    "beta": "pnpm publish --tag beta",
    "prepublishOnly": "pinst --disable",
    "postpublish": "pinst --enable",
    "prepare": "vp config --no-agent"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "14.0.0-beta.5",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.11",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "15.0.0-beta.4",
    "@stylistic/eslint-plugin": "6.0.1",
    "@types/node": ">=22",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/eslint-plugin": "1.6.28",
    "conventional-changelog-conventionalcommits": "10.4.0",
    "eslint": "10.15.0",
    "eslint-plugin-jsdoc": "65.5.1",
    "eslint-plugin-security": "4.2.1",
    "eslint-plugin-unicorn": "80.0.0",
    "markdownlint-cli": "0.50.1",
    "npm-run-all2": "9.1.0",
    "oxlint-config-decent": "5.0.0",
    "oxlint-plugin-eslint": "1.94.0",
    "pinst": "3.0.0",
    "postgres-pool": "12.0.3",
    "semantic-release": "26.0.1",
    "strict-event-emitter-types": "2.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "packageManager": "pnpm@12.22.0+sha512.894940a3d9a57dfa6fd373990fb4e41e09c2f2d76d982ed1d75275d39267f988fb4e2d40900cbe9921c68d97c67aa1a1096d276633db248f7b34927ac9ddb7a4"
}
