{
  "name": "bigal",
  "version": "16.1.0",
  "description": "A type-safe PostgreSQL ORM for TypeScript on Node.js, Bun, and Deno. Fluent query builder, decorator-based models, and queries tuned for Postgres.",
  "keywords": [
    "bun",
    "database",
    "decorator",
    "deno",
    "fluent-api",
    "jsonb",
    "node",
    "orm",
    "pg",
    "pgvector",
    "postgres",
    "postgresql",
    "query-builder",
    "repository-pattern",
    "sql",
    "type-safe",
    "typescript"
  ],
  "homepage": "https://bigalorm.github.io/bigal/",
  "bugs": {
    "url": "https://github.com/bigalorm/bigal/issues"
  },
  "license": "MIT",
  "author": "Jim Geurts <jim@biacreations.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigalorm/bigal.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "vp pack",
    "check:types": "tsc --noEmit --skipLibCheck",
    "test": "pnpm run check:types && vp test run",
    "lint:markdown": "markdownlint '**/*.md' --ignore '**/node_modules/**' --ignore '**/dist/**' --ignore 'internal/**' --config=.github/linters/.markdown-lint.yml --fix",
    "lint:code": "vp lint --fix",
    "lint": "pnpm run format && run-p lint:*",
    "format": "vp fmt",
    "beta": "pnpm publish --tag beta",
    "prepublishOnly": "pinst --disable",
    "postpublish": "pinst --enable",
    "prepare": "vp config --no-agent"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "14.0.0-beta.4",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "15.0.0-beta.3",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": ">=22",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/eslint-plugin": "1.6.27",
    "conventional-changelog-conventionalcommits": "10.4.0",
    "eslint": "10.11.0",
    "eslint-plugin-jsdoc": "64.5.4",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-unicorn": "75.0.0",
    "markdownlint-cli": "0.49.1",
    "npm-run-all2": "9.0.3",
    "oxlint-config-decent": "5.0.0",
    "oxlint-plugin-eslint": "1.83.0",
    "pinst": "3.0.0",
    "postgres-pool": "12.0.1",
    "semantic-release": "25.0.9",
    "strict-event-emitter-types": "2.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
